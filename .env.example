# Local generated data. Relative paths are resolved from the repository root.
LIVECLIP_DATA_DIR=./data/projects

# Required for real imports: one or more absolute directories separated by the
# platform path separator (`:` on macOS). Demo adds only its own generated root.
LIVECLIP_ALLOWED_MEDIA_ROOTS=/absolute/path/to/media

# Leave blank to disable local API authentication. Never commit a real token.
LIVECLIP_API_TOKEN=
LIVECLIP_WORKSPACE_USERNAME=local-admin
# 多人协作：用户名到独立 Bearer Token 的 JSON；配置后仍需保留管理员 LIVECLIP_API_TOKEN
LIVECLIP_WORKSPACE_TOKENS=
# 首次启用账号登录时设置；只在管理员尚未设置密码时生效。至少 12 个字符。
LIVECLIP_BOOTSTRAP_ADMIN_PASSWORD=
LIVECLIP_SESSION_TTL_HOURS=12
LIVECLIP_API_HOST=127.0.0.1
LIVECLIP_API_PORT=8765
LIVECLIP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LIVECLIP_MEDIA_URL_TTL_SECONDS=900

# Modes: mlx-codex = pinned local MLX Whisper Large V3 ASR + local Codex CLI editor;
# openrouter-codex = OpenRouter Whisper Large V3 ASR + local Codex CLI editor;
# openai-codex = OpenAI timestamp ASR + local Codex CLI editor; openai = OpenAI ASR
# + Responses editor; mock/mock-codex are explicit test/dev modes.
# Normal processing never silently changes this value or falls back to Mock.
# Codex uses its saved ChatGPT login, but still needs a separate ASR credential
# because Codex CLI does not transcribe video audio.
LIVECLIP_AI_PROVIDER=openrouter-codex
# Used only by mlx-codex. Install the pinned full-precision snapshot with
# `make setup-local-asr`; local ASR always runs with concurrency 1.
LIVECLIP_MLX_ASR_MODEL_PATH=./data/models/whisper-large-v3-mlx
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ASR_MODEL=openai/whisper-large-v3
OPENAI_API_KEY=
LIVECLIP_CODEX_EXECUTABLE=codex

# Capability-driven v1 default: whisper-1 provides real segment/word times.
# Current general OpenAI guidance recommends gpt-transcribe when timestamps are not required.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Accuracy-first editor default; Codex uses high reasoning only for v2 Global Review.
# Override explicitly only when comparing another immutable run configuration.
OPENAI_LLM_MODEL=gpt-5.6-sol

ASR_CHUNK_SECONDS=90
ASR_CHUNK_OVERLAP_SECONDS=5
ASR_MAX_CHUNK_BYTES=24000000
ASR_CONCURRENCY=4
# OpenRouter sends this best-effort through provider.options.groq.prompt.
ASR_VOCABULARY_PROMPT=LiveClip、直播、高光、切片
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_REQUEST_RETRIES=2
OPENAI_RETRY_BASE_SECONDS=1
OPENAI_RETRY_MAX_SECONDS=30

DEFAULT_TOP_N=15
MIN_CLIP_SECONDS=30
MAX_CLIP_SECONDS=90

PREVIEW_RENDER_WIDTH=540
PREVIEW_RENDER_HEIGHT=960
FINAL_RENDER_WIDTH=1080
FINAL_RENDER_HEIGHT=1920
LIVECLIP_VIDEO_ENCODER=auto

WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
MAX_STAGE_RETRIES=3

LOG_LEVEL=INFO

# Optional explicit prices only. LiveClip never embeds provider prices.
OPENAI_LLM_INPUT_PRICE_PER_MILLION=
OPENAI_LLM_OUTPUT_PRICE_PER_MILLION=
