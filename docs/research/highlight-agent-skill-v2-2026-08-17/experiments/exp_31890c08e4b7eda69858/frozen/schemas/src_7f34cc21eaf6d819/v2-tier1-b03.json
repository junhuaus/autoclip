{
  "$defs": {
    "AssessmentConfidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "AssessmentConfidence",
      "type": "string"
    },
    "AtomicScores": {
      "additionalProperties": false,
      "properties": {
        "content_value": {
          "maximum": 4,
          "minimum": 0,
          "title": "Content Value",
          "type": "integer"
        },
        "editorial_utility": {
          "maximum": 4,
          "minimum": 0,
          "title": "Editorial Utility",
          "type": "integer"
        },
        "evidence_fidelity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Evidence Fidelity",
          "type": "integer"
        },
        "hook_strength": {
          "maximum": 4,
          "minimum": 0,
          "title": "Hook Strength",
          "type": "integer"
        },
        "standalone_completeness": {
          "maximum": 4,
          "minimum": 0,
          "title": "Standalone Completeness",
          "type": "integer"
        }
      },
      "required": [
        "content_value",
        "hook_strength",
        "standalone_completeness",
        "evidence_fidelity",
        "editorial_utility"
      ],
      "title": "AtomicScores",
      "type": "object"
    },
    "CandidateAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_confidence": {
          "$ref": "#/$defs/AssessmentConfidence"
        },
        "assessment_reason": {
          "maxLength": 260,
          "minLength": 1,
          "title": "Assessment Reason",
          "type": "string"
        },
        "candidate_id": {
          "enum": [
            "candidate_a1d7354902e340e6",
            "candidate_27e8574669b9e0c2",
            "candidate_f262b8f87ac47de0",
            "candidate_59b038f803f24532",
            "candidate_8e329a9311a36567",
            "candidate_059b8bf41086721a",
            "candidate_3f73ee8bb04ee052",
            "candidate_1d0bcd4f6ed22861",
            "candidate_84a0a525d56ff5bd",
            "candidate_374a9f9e7e085c59",
            "candidate_2e039a3e91689484",
            "candidate_9d47bf21dc719613",
            "candidate_eda02f3bbfbc7462",
            "candidate_8ba2743da2b9cb9e",
            "candidate_e2c68e2187b0dda3"
          ],
          "type": "string"
        },
        "content_risk_flags": {
          "items": {
            "$ref": "#/$defs/ContentRiskFlag"
          },
          "maxItems": 8,
          "title": "Content Risk Flags",
          "type": "array"
        },
        "disposition": {
          "$ref": "#/$defs/CandidateDisposition"
        },
        "evidence_flags": {
          "items": {
            "$ref": "#/$defs/EvidenceFlag"
          },
          "maxItems": 4,
          "title": "Evidence Flags",
          "type": "array"
        },
        "primary_claim": {
          "anyOf": [
            {
              "maxLength": 180,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Primary Claim"
        },
        "risk_summary": {
          "maxLength": 240,
          "title": "Risk Summary",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/AtomicScores"
        },
        "topic_hypothesis": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Topic Hypothesis"
        },
        "uncertainty_flags": {
          "items": {
            "$ref": "#/$defs/UncertaintyFlag"
          },
          "maxItems": 6,
          "title": "Uncertainty Flags",
          "type": "array"
        },
        "unusable_reason": {
          "$ref": "#/$defs/UnusableReason"
        }
      },
      "required": [
        "candidate_id",
        "disposition",
        "unusable_reason",
        "topic_hypothesis",
        "primary_claim",
        "assessment_reason",
        "assessment_confidence",
        "uncertainty_flags",
        "scores",
        "evidence_flags",
        "content_risk_flags",
        "risk_summary"
      ],
      "title": "CandidateAssessment",
      "type": "object"
    },
    "CandidateDisposition": {
      "enum": [
        "assessable",
        "unusable"
      ],
      "title": "CandidateDisposition",
      "type": "string"
    },
    "ContentRiskFlag": {
      "enum": [
        "health_or_safety_claim",
        "legal_or_financial_claim",
        "personal_data",
        "copyright_or_third_party",
        "reputation_or_defamation",
        "sponsor_or_advertising",
        "unsafe_instruction",
        "sensitive_content"
      ],
      "title": "ContentRiskFlag",
      "type": "string"
    },
    "EvidenceFlag": {
      "enum": [
        "asr_uncertain",
        "context_dependency",
        "incomplete_claim",
        "visual_verification_required"
      ],
      "title": "EvidenceFlag",
      "type": "string"
    },
    "UncertaintyFlag": {
      "enum": [
        "asr_ambiguity",
        "missing_question",
        "missing_context",
        "mixed_topics",
        "visual_dependency",
        "claim_ambiguity"
      ],
      "title": "UncertaintyFlag",
      "type": "string"
    },
    "UnusableReason": {
      "enum": [
        "none",
        "fragment_only",
        "context_dependent",
        "asr_unintelligible",
        "unsafe_to_publish"
      ],
      "title": "UnusableReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessments": {
      "items": {
        "$ref": "#/$defs/CandidateAssessment"
      },
      "maxItems": 15,
      "minItems": 1,
      "title": "Assessments",
      "type": "array"
    }
  },
  "required": [
    "assessments"
  ],
  "title": "AssessmentBatch",
  "type": "object"
}
