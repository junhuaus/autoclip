{
  "$defs": {
    "AssessmentConfidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "AssessmentConfidence",
      "type": "string"
    },
    "AtomicScores": {
      "additionalProperties": false,
      "properties": {
        "content_value": {
          "maximum": 4,
          "minimum": 0,
          "title": "Content Value",
          "type": "integer"
        },
        "editorial_utility": {
          "maximum": 4,
          "minimum": 0,
          "title": "Editorial Utility",
          "type": "integer"
        },
        "evidence_fidelity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Evidence Fidelity",
          "type": "integer"
        },
        "hook_strength": {
          "maximum": 4,
          "minimum": 0,
          "title": "Hook Strength",
          "type": "integer"
        },
        "standalone_completeness": {
          "maximum": 4,
          "minimum": 0,
          "title": "Standalone Completeness",
          "type": "integer"
        }
      },
      "required": [
        "content_value",
        "hook_strength",
        "standalone_completeness",
        "evidence_fidelity",
        "editorial_utility"
      ],
      "title": "AtomicScores",
      "type": "object"
    },
    "CandidateAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_confidence": {
          "$ref": "#/$defs/AssessmentConfidence"
        },
        "assessment_reason": {
          "maxLength": 260,
          "minLength": 1,
          "title": "Assessment Reason",
          "type": "string"
        },
        "candidate_id": {
          "enum": [
            "candidate_ecc8f9bdbcef1f0b",
            "candidate_b97428705eaff8a0",
            "candidate_9e9054f2deb55202",
            "candidate_3c92e6847aff0c59",
            "candidate_b110d906807b06f5",
            "candidate_373756f54a23ac46",
            "candidate_c512c4453cde77d1",
            "candidate_04479a7661739b63",
            "candidate_0650eee23c06e676",
            "candidate_bef585871fbac01e",
            "candidate_6721fcbb3782d23b",
            "candidate_5b457445f2236f35",
            "candidate_f3d1b16dd252adfd",
            "candidate_0c9ab3b5a64030d5",
            "candidate_2169870825746d02"
          ],
          "type": "string"
        },
        "content_risk_flags": {
          "items": {
            "$ref": "#/$defs/ContentRiskFlag"
          },
          "maxItems": 8,
          "title": "Content Risk Flags",
          "type": "array"
        },
        "disposition": {
          "$ref": "#/$defs/CandidateDisposition"
        },
        "evidence_flags": {
          "items": {
            "$ref": "#/$defs/EvidenceFlag"
          },
          "maxItems": 4,
          "title": "Evidence Flags",
          "type": "array"
        },
        "primary_claim": {
          "anyOf": [
            {
              "maxLength": 180,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Primary Claim"
        },
        "risk_summary": {
          "maxLength": 240,
          "title": "Risk Summary",
          "type": "string"
        },
        "scores": {
          "$ref": "#/$defs/AtomicScores"
        },
        "topic_hypothesis": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Topic Hypothesis"
        },
        "uncertainty_flags": {
          "items": {
            "$ref": "#/$defs/UncertaintyFlag"
          },
          "maxItems": 6,
          "title": "Uncertainty Flags",
          "type": "array"
        },
        "unusable_reason": {
          "$ref": "#/$defs/UnusableReason"
        }
      },
      "required": [
        "candidate_id",
        "disposition",
        "unusable_reason",
        "topic_hypothesis",
        "primary_claim",
        "assessment_reason",
        "assessment_confidence",
        "uncertainty_flags",
        "scores",
        "evidence_flags",
        "content_risk_flags",
        "risk_summary"
      ],
      "title": "CandidateAssessment",
      "type": "object"
    },
    "CandidateDisposition": {
      "enum": [
        "assessable",
        "unusable"
      ],
      "title": "CandidateDisposition",
      "type": "string"
    },
    "ContentRiskFlag": {
      "enum": [
        "health_or_safety_claim",
        "legal_or_financial_claim",
        "personal_data",
        "copyright_or_third_party",
        "reputation_or_defamation",
        "sponsor_or_advertising",
        "unsafe_instruction",
        "sensitive_content"
      ],
      "title": "ContentRiskFlag",
      "type": "string"
    },
    "EvidenceFlag": {
      "enum": [
        "asr_uncertain",
        "context_dependency",
        "incomplete_claim",
        "visual_verification_required"
      ],
      "title": "EvidenceFlag",
      "type": "string"
    },
    "UncertaintyFlag": {
      "enum": [
        "asr_ambiguity",
        "missing_question",
        "missing_context",
        "mixed_topics",
        "visual_dependency",
        "claim_ambiguity"
      ],
      "title": "UncertaintyFlag",
      "type": "string"
    },
    "UnusableReason": {
      "enum": [
        "none",
        "fragment_only",
        "context_dependent",
        "asr_unintelligible",
        "unsafe_to_publish"
      ],
      "title": "UnusableReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessments": {
      "items": {
        "$ref": "#/$defs/CandidateAssessment"
      },
      "maxItems": 15,
      "minItems": 1,
      "title": "Assessments",
      "type": "array"
    }
  },
  "required": [
    "assessments"
  ],
  "title": "AssessmentBatch",
  "type": "object"
}
