{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusters", "system_evaluations", "preferred_system_ids", "verdict_reason", "limitations"],
  "properties": {
    "clusters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cluster_id", "canonical_topic", "alignment_confidence", "members", "assessment"],
        "properties": {
          "cluster_id": {"type": "string", "pattern": "^t[0-9]{3}$"},
          "canonical_topic": {"type": "string", "minLength": 1, "maxLength": 100},
          "alignment_confidence": {"type": "string", "enum": ["low", "medium", "high"]},
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 36,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "anonymous_system_id",
                "highlight_id",
                "candidate_id",
                "claim_fidelity",
                "editorial_value",
                "hook_strength",
                "expression_completeness",
                "title_copy_quality",
                "representative_quality",
                "assessment"
              ],
              "properties": {
                "anonymous_system_id": {"type": "string", "pattern": "^[A-Z][0-9]$"},
                "highlight_id": {"type": "string", "pattern": "^h[0-9]{2}$"},
                "candidate_id": {"type": "string", "pattern": "^candidate_[a-f0-9]{16}$"},
                "claim_fidelity": {"type": "integer", "minimum": 0, "maximum": 4},
                "editorial_value": {"type": "integer", "minimum": 0, "maximum": 4},
                "hook_strength": {"type": "integer", "minimum": 0, "maximum": 4},
                "expression_completeness": {"type": "integer", "minimum": 0, "maximum": 4},
                "title_copy_quality": {"type": "integer", "minimum": 0, "maximum": 4},
                "representative_quality": {"type": "integer", "minimum": 0, "maximum": 4},
                "assessment": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          },
          "assessment": {"type": "string", "minLength": 1, "maxLength": 800}
        }
      }
    },
    "system_evaluations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anonymous_system_id",
          "topic_discovery",
          "evidence_fidelity",
          "clip_selection",
          "editorial_usability",
          "portfolio_quality",
          "strengths",
          "weaknesses"
        ],
        "properties": {
          "anonymous_system_id": {"type": "string", "pattern": "^[A-Z][0-9]$"},
          "topic_discovery": {"type": "integer", "minimum": 0, "maximum": 4},
          "evidence_fidelity": {"type": "integer", "minimum": 0, "maximum": 4},
          "clip_selection": {"type": "integer", "minimum": 0, "maximum": 4},
          "editorial_usability": {"type": "integer", "minimum": 0, "maximum": 4},
          "portfolio_quality": {"type": "integer", "minimum": 0, "maximum": 4},
          "strengths": {"type": "string", "minLength": 1, "maxLength": 1000},
          "weaknesses": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "preferred_system_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "string", "pattern": "^[A-Z][0-9]$"}
    },
    "verdict_reason": {"type": "string", "minLength": 1, "maxLength": 1400},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    }
  }
}
