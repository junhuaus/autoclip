{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clusters": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "alignment_confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "assessment": {
            "maxLength": 800,
            "minLength": 1,
            "type": "string"
          },
          "canonical_topic": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "cluster_id": {
            "pattern": "^t[0-9]{3}$",
            "type": "string"
          },
          "members": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "anonymous_system_id": {
                  "enum": [
                    "M4",
                    "Q7",
                    "R2"
                  ],
                  "type": "string"
                },
                "assessment": {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                },
                "candidate_id": {
                  "enum": [
                    "candidate_0650eee23c06e676",
                    "candidate_0c49c6488ae5fe28",
                    "candidate_2169870825746d02",
                    "candidate_259a47e73cd8edad",
                    "candidate_35a860b83062d6ab",
                    "candidate_373756f54a23ac46",
                    "candidate_45f74801b32ad9cf",
                    "candidate_464b0f2aee1d8a44",
                    "candidate_554c3d7035ba1055",
                    "candidate_65678839045aab40",
                    "candidate_6721fcbb3782d23b",
                    "candidate_b66177d9d0ec57ef",
                    "candidate_bef585871fbac01e",
                    "candidate_c393f29d34250a55",
                    "candidate_f49be10488a46e67",
                    "candidate_f89ea722be8ee018",
                    "candidate_fa0cd44fc3dcaa6b"
                  ],
                  "type": "string"
                },
                "claim_fidelity": {
                  "maximum": 4,
                  "minimum": 0,
                  "type": "integer"
                },
                "editorial_value": {
                  "maximum": 4,
                  "minimum": 0,
                  "type": "integer"
                },
                "expression_completeness": {
                  "maximum": 4,
                  "minimum": 0,
                  "type": "integer"
                },
                "highlight_id": {
                  "enum": [
                    "h01",
                    "h02",
                    "h03",
                    "h04",
                    "h05",
                    "h06",
                    "h07",
                    "h08",
                    "h09",
                    "h10",
                    "h11"
                  ],
                  "type": "string"
                },
                "hook_strength": {
                  "maximum": 4,
                  "minimum": 0,
                  "type": "integer"
                },
                "representative_quality": {
                  "maximum": 4,
                  "minimum": 0,
                  "type": "integer"
                },
                "title_copy_quality": {
                  "maximum": 4,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "anonymous_system_id",
                "highlight_id",
                "candidate_id",
                "claim_fidelity",
                "editorial_value",
                "hook_strength",
                "expression_completeness",
                "title_copy_quality",
                "representative_quality",
                "assessment"
              ],
              "type": "object"
            },
            "maxItems": 36,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "cluster_id",
          "canonical_topic",
          "alignment_confidence",
          "members",
          "assessment"
        ],
        "type": "object"
      },
      "maxItems": 36,
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
    },
    "preferred_system_ids": {
      "items": {
        "enum": [
          "M4",
          "Q7",
          "R2"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "system_evaluations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anonymous_system_id": {
            "enum": [
              "M4",
              "Q7",
              "R2"
            ],
            "type": "string"
          },
          "clip_selection": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "editorial_usability": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "evidence_fidelity": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "portfolio_quality": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "strengths": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "topic_discovery": {
            "maximum": 4,
            "minimum": 0,
            "type": "integer"
          },
          "weaknesses": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "anonymous_system_id",
          "topic_discovery",
          "evidence_fidelity",
          "clip_selection",
          "editorial_usability",
          "portfolio_quality",
          "strengths",
          "weaknesses"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "verdict_reason": {
      "maxLength": 1400,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "clusters",
    "system_evaluations",
    "preferred_system_ids",
    "verdict_reason",
    "limitations"
  ],
  "type": "object"
}
