{
  "$defs": {
    "BoundarySide": {
      "enum": [
        "left",
        "right"
      ],
      "title": "BoundarySide",
      "type": "string"
    },
    "BoundaryTopicReport": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "$ref": "#/$defs/BoundarySide"
        },
        "topic_summary": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Topic Summary",
          "type": "string"
        },
        "viewer_promise": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Viewer Promise",
          "type": "string"
        },
        "evidence_cue_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Evidence Cue Ids",
          "type": "array"
        },
        "continuation_expected": {
          "title": "Continuation Expected",
          "type": "boolean"
        },
        "related_candidate_ids": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Related Candidate Ids",
          "type": "array"
        }
      },
      "required": [
        "side",
        "topic_summary",
        "viewer_promise",
        "evidence_cue_ids",
        "continuation_expected"
      ],
      "title": "BoundaryTopicReport",
      "type": "object"
    },
    "CandidateClip": {
      "additionalProperties": false,
      "description": "A deterministic rough candidate; transcript fields remain untrusted data.",
      "properties": {
        "candidate_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "source_start_ms": {
          "minimum": 0,
          "title": "Source Start Ms",
          "type": "integer"
        },
        "source_end_ms": {
          "exclusiveMinimum": 0,
          "title": "Source End Ms",
          "type": "integer"
        },
        "allowed_start_ms": {
          "minimum": 0,
          "title": "Allowed Start Ms",
          "type": "integer"
        },
        "allowed_end_ms": {
          "exclusiveMinimum": 0,
          "title": "Allowed End Ms",
          "type": "integer"
        },
        "text": {
          "maxLength": 24000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "context_before": {
          "default": "",
          "maxLength": 4000,
          "title": "Context Before",
          "type": "string"
        },
        "context_after": {
          "default": "",
          "maxLength": 4000,
          "title": "Context After",
          "type": "string"
        },
        "rule_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Rule Score",
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "source_start_ms",
        "source_end_ms",
        "allowed_start_ms",
        "allowed_end_ms",
        "text",
        "rule_score",
        "reasons",
        "segment_ids"
      ],
      "title": "CandidateClip",
      "type": "object"
    },
    "ChainCandidateV5": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "clip_profile": {
          "$ref": "#/$defs/ClipProfile"
        },
        "source_topic_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Topic Id",
          "type": "string"
        },
        "topic_chain_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Topic Chain Id",
          "type": "string"
        },
        "source_fragment_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Fragment Ids",
          "type": "array"
        },
        "start_cue_id": {
          "minimum": 1,
          "title": "Start Cue Id",
          "type": "integer"
        },
        "end_cue_id": {
          "minimum": 1,
          "title": "End Cue Id",
          "type": "integer"
        },
        "central_question": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Central Question",
          "type": "string"
        },
        "learning_outcome": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Learning Outcome",
          "type": "string"
        },
        "title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence_cue_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Evidence Cue Ids",
          "type": "array"
        },
        "natural_subunit": {
          "default": false,
          "title": "Natural Subunit",
          "type": "boolean"
        },
        "natural_split_evidence_cue_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 80,
          "title": "Natural Split Evidence Cue Ids",
          "type": "array"
        },
        "variant_of": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Of"
        },
        "variant_relationship": {
          "anyOf": [
            {
              "enum": [
                "short_version_of",
                "long_version_of"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Relationship"
        },
        "origin_kind": {
          "enum": [
            "derived",
            "chain_new"
          ],
          "title": "Origin Kind",
          "type": "string"
        },
        "original_candidate_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Original Candidate Ids",
          "type": "array"
        },
        "origin_reason": {
          "minLength": 1,
          "title": "Origin Reason",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "clip_profile",
        "source_topic_id",
        "topic_chain_id",
        "source_fragment_ids",
        "start_cue_id",
        "end_cue_id",
        "central_question",
        "learning_outcome",
        "title",
        "summary",
        "evidence_cue_ids",
        "origin_kind",
        "original_candidate_ids",
        "origin_reason"
      ],
      "title": "ChainCandidateV5",
      "type": "object"
    },
    "ClipProfile": {
      "description": "Independent editorial units with different deterministic duration contracts.",
      "enum": [
        "short_highlight",
        "mini_lesson"
      ],
      "title": "ClipProfile",
      "type": "string"
    },
    "CueRange": {
      "additionalProperties": false,
      "properties": {
        "start_cue_id": {
          "minimum": 1,
          "title": "Start Cue Id",
          "type": "integer"
        },
        "end_cue_id": {
          "minimum": 1,
          "title": "End Cue Id",
          "type": "integer"
        }
      },
      "required": [
        "start_cue_id",
        "end_cue_id"
      ],
      "title": "CueRange",
      "type": "object"
    },
    "DiscoveryBatchOutputV5": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "5",
          "default": "5",
          "title": "Schema Version",
          "type": "string"
        },
        "contract_version": {
          "const": "semantic-v5-lineage-v1",
          "default": "semantic-v5-lineage-v1",
          "title": "Contract Version",
          "type": "string"
        },
        "batch_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Batch Id",
          "type": "string"
        },
        "batch_context": {
          "$ref": "#/$defs/TimeRangeV4"
        },
        "ownership_interval": {
          "$ref": "#/$defs/TimeRangeV4"
        },
        "logical_windows": {
          "items": {
            "$ref": "#/$defs/LogicalWindowDiscoveryV5"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Logical Windows",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/DiscoveryCandidateV5"
          },
          "title": "Candidates",
          "type": "array"
        },
        "topic_fragments": {
          "items": {
            "$ref": "#/$defs/TopicFragmentV5"
          },
          "title": "Topic Fragments",
          "type": "array"
        }
      },
      "required": [
        "batch_id",
        "batch_context",
        "ownership_interval",
        "logical_windows",
        "candidates",
        "topic_fragments"
      ],
      "title": "DiscoveryBatchOutputV5",
      "type": "object"
    },
    "DiscoveryCandidateV5": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "source_topic_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Topic Id",
          "type": "string"
        },
        "topic_fragment_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 80,
          "minItems": 1,
          "title": "Topic Fragment Ids",
          "type": "array"
        },
        "topic_summary": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Topic Summary",
          "type": "string"
        },
        "central_question": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Central Question",
          "type": "string"
        },
        "learning_outcome": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Learning Outcome",
          "type": "string"
        },
        "start_cue_id": {
          "minimum": 1,
          "title": "Start Cue Id",
          "type": "integer"
        },
        "end_cue_id": {
          "minimum": 1,
          "title": "End Cue Id",
          "type": "integer"
        },
        "evidence_cue_ids": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Evidence Cue Ids",
          "type": "array"
        },
        "possible_profiles": {
          "items": {
            "$ref": "#/$defs/ClipProfile"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Possible Profiles",
          "type": "array"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/DiscoveryRiskV5"
          },
          "title": "Risks",
          "type": "array"
        },
        "source_window_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Source Window Ids",
          "type": "array"
        },
        "source_batch_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Batch Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "source_topic_id",
        "topic_fragment_ids",
        "topic_summary",
        "central_question",
        "learning_outcome",
        "start_cue_id",
        "end_cue_id",
        "evidence_cue_ids",
        "possible_profiles",
        "risks",
        "source_window_ids",
        "source_batch_id"
      ],
      "title": "DiscoveryCandidateV5",
      "type": "object"
    },
    "DiscoveryRiskV5": {
      "additionalProperties": false,
      "properties": {
        "risk_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Risk Id",
          "type": "string"
        },
        "flag": {
          "$ref": "#/$defs/RiskFlagV4"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_cue_ids": {
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Evidence Cue Ids",
          "type": "array"
        }
      },
      "required": [
        "risk_id",
        "flag",
        "reason",
        "evidence_cue_ids"
      ],
      "title": "DiscoveryRiskV5",
      "type": "object"
    },
    "LinkRelationshipV4": {
      "enum": [
        "continuation",
        "supporting_example",
        "next_step_same_lesson",
        "summary_same_lesson",
        "adjacent_but_independent",
        "topic_switch",
        "uncertain"
      ],
      "title": "LinkRelationshipV4",
      "type": "string"
    },
    "LinkReviewRequestV4": {
      "additionalProperties": false,
      "properties": {
        "link_review_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Link Review Id",
          "type": "string"
        },
        "boundary_ms": {
          "minimum": 0,
          "title": "Boundary Ms",
          "type": "integer"
        },
        "context_range": {
          "$ref": "#/$defs/TimeRangeV4"
        },
        "left_window_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Left Window Id",
          "type": "string"
        },
        "right_window_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Right Window Id",
          "type": "string"
        },
        "left_fragment": {
          "$ref": "#/$defs/TopicFragmentV4"
        },
        "right_fragment": {
          "$ref": "#/$defs/TopicFragmentV4"
        }
      },
      "required": [
        "link_review_id",
        "boundary_ms",
        "context_range",
        "left_window_id",
        "right_window_id",
        "left_fragment",
        "right_fragment"
      ],
      "title": "LinkReviewRequestV4",
      "type": "object"
    },
    "LinkReviewV4": {
      "additionalProperties": false,
      "properties": {
        "link_review_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Link Review Id",
          "type": "string"
        },
        "left_fragment_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Left Fragment Id",
          "type": "string"
        },
        "right_fragment_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Right Fragment Id",
          "type": "string"
        },
        "same_topic": {
          "title": "Same Topic",
          "type": "boolean"
        },
        "same_central_objective": {
          "title": "Same Central Objective",
          "type": "boolean"
        },
        "relationship": {
          "$ref": "#/$defs/LinkRelationshipV4"
        },
        "merged_topic_summary": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Merged Topic Summary",
          "type": "string"
        },
        "central_question": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Central Question",
          "type": "string"
        },
        "learning_outcome": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Learning Outcome",
          "type": "string"
        },
        "topic_closed_on_right": {
          "title": "Topic Closed On Right",
          "type": "boolean"
        },
        "needs_next_boundary": {
          "title": "Needs Next Boundary",
          "type": "boolean"
        },
        "evidence_cue_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 160,
          "minItems": 1,
          "title": "Evidence Cue Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "link_review_id",
        "left_fragment_id",
        "right_fragment_id",
        "same_topic",
        "same_central_objective",
        "relationship",
        "merged_topic_summary",
        "central_question",
        "learning_outcome",
        "topic_closed_on_right",
        "needs_next_boundary",
        "evidence_cue_ids",
        "confidence"
      ],
      "title": "LinkReviewV4",
      "type": "object"
    },
    "LogicalWindowDiscoveryV5": {
      "additionalProperties": false,
      "properties": {
        "logical_window_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Logical Window Id",
          "type": "string"
        },
        "window_start_ms": {
          "minimum": 0,
          "title": "Window Start Ms",
          "type": "integer"
        },
        "window_end_ms": {
          "exclusiveMinimum": 0,
          "title": "Window End Ms",
          "type": "integer"
        },
        "candidate_ids": {
          "default": [],
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "fragment_ids": {
          "default": [],
          "items": {
            "maxLength": 96,
