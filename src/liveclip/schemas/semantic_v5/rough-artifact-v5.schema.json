    "MiniLessonArtifactConfigV5": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "semantic_windowed",
          "default": "semantic_windowed",
          "title": "Algorithm",
          "type": "string"
        },
        "clip_profile": {
          "const": "mini_lesson",
          "default": "mini_lesson",
          "title": "Clip Profile",
          "type": "string"
        },
        "minimum_clip_ms": {
          "const": 90000,
          "default": 90000,
          "title": "Minimum Clip Ms",
          "type": "integer"
        },
        "target_clip_ms": {
          "const": 180000,
          "default": 180000,
          "title": "Target Clip Ms",
          "type": "integer"
        },
        "maximum_clip_ms": {
          "const": 300000,
          "default": 300000,
          "title": "Maximum Clip Ms",
          "type": "integer"
        },
        "top_n": {
          "maximum": 100,
          "minimum": 1,
