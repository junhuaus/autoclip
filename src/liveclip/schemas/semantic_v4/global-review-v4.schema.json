{
  "$defs": {
    "CandidateGlobalReviewV4": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "clip_profile": {
          "$ref": "#/$defs/ClipProfile"
        },
        "source_topic_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Topic Id",
          "type": "string"
        },
        "topic_chain_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Topic Chain Id",
          "type": "string"
        },
        "source_fragment_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Source Fragment Ids",
          "type": "array"
        },
        "start_cue_id": {
          "minimum": 1,
          "title": "Start Cue Id",
          "type": "integer"
        },
        "end_cue_id": {
          "minimum": 1,
          "title": "End Cue Id",
          "type": "integer"
        },
        "central_question": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Central Question",
          "type": "string"
        },
        "learning_outcome": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Learning Outcome",
          "type": "string"
        },
        "title": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content_decision": {
          "$ref": "#/$defs/ContentDecisionV4"
        },
        "publish_status": {
          "$ref": "#/$defs/PublishStatusV4"
        },
        "quality_flags": {
          "items": {
            "$ref": "#/$defs/QualityFlagV4"
          },
          "maxItems": 30,
          "title": "Quality Flags",
          "type": "array"
        },
        "risk_flags": {
          "items": {
            "$ref": "#/$defs/RiskFlagV4"
          },
          "maxItems": 20,
          "title": "Risk Flags",
          "type": "array"
        },
        "interruption_review": {
          "items": {
            "$ref": "#/$defs/InterruptionReviewV4"
          },
          "maxItems": 30,
          "title": "Interruption Review",
          "type": "array"
        },
        "scores": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShortHighlightScoresV4"
            },
            {
              "$ref": "#/$defs/MiniLessonScoresV4"
            }
          ],
          "title": "Scores"
        },
        "total_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Total Score",
          "type": "integer"
        },
        "duplicate_group_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Group Id"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "variant_of": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Of"
        },
        "variant_relationship": {
          "anyOf": [
            {
              "enum": [
                "short_version_of",
                "long_version_of"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Relationship"
        },
        "evidence_cue_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Evidence Cue Ids",
          "type": "array"
        },
        "review_reason": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Review Reason",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "clip_profile",
        "source_topic_id",
        "topic_chain_id",
        "source_fragment_ids",
        "start_cue_id",
        "end_cue_id",
        "central_question",
        "learning_outcome",
        "title",
        "summary",
        "content_decision",
        "publish_status",
        "scores",
        "total_score",
        "evidence_cue_ids",
        "review_reason"
      ],
      "title": "CandidateGlobalReviewV4",
      "type": "object"
    },
    "ClipProfile": {
      "description": "Independent editorial units with different deterministic duration contracts.",
      "enum": [
        "short_highlight",
        "mini_lesson"
      ],
      "title": "ClipProfile",
      "type": "string"
    },
    "ContentDecisionV4": {
      "enum": [
        "keep",
        "repair_boundary",
        "drop"
      ],
      "title": "ContentDecisionV4",
      "type": "string"
    },
    "InterruptionReviewV4": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "$ref": "#/$defs/InterruptionSeverityV4"
        },
        "type": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Type",
          "type": "string"
        },
        "evidence_cue_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 80,
          "title": "Evidence Cue Ids",
          "type": "array"
        },
        "description": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "severity",
        "type",
        "description",
        "blocking"
      ],
      "title": "InterruptionReviewV4",
      "type": "object"
    },
    "InterruptionSeverityV4": {
      "enum": [
        "none",
        "minor",
        "material"
      ],
      "title": "InterruptionSeverityV4",
      "type": "string"
    },
    "MiniLessonScoresV4": {
      "additionalProperties": false,
      "properties": {
        "central_objective_clarity": {
          "maximum": 20,
          "minimum": 0,
          "title": "Central Objective Clarity",
          "type": "integer"
        },
        "completeness_and_closure": {
          "maximum": 20,
          "minimum": 0,
          "title": "Completeness And Closure",
          "type": "integer"
        },
        "teaching_structure": {
          "maximum": 15,
          "minimum": 0,
          "title": "Teaching Structure",
          "type": "integer"
        },
        "standalone_understanding": {
          "maximum": 15,
          "minimum": 0,
          "title": "Standalone Understanding",
          "type": "integer"
        },
        "information_density": {
          "maximum": 10,
          "minimum": 0,
          "title": "Information Density",
          "type": "integer"
        },
        "edit_cleanliness": {
          "maximum": 10,
          "minimum": 0,
          "title": "Edit Cleanliness",
          "type": "integer"
        },
        "title_summary_fidelity": {
          "maximum": 10,
          "minimum": 0,
          "title": "Title Summary Fidelity",
          "type": "integer"
        }
      },
      "required": [
        "central_objective_clarity",
        "completeness_and_closure",
        "teaching_structure",
        "standalone_understanding",
        "information_density",
        "edit_cleanliness",
        "title_summary_fidelity"
      ],
      "title": "MiniLessonScoresV4",
      "type": "object"
    },
    "PublishStatusV4": {
      "enum": [
        "auto",
        "manual",
        "blocked"
      ],
      "title": "PublishStatusV4",
      "type": "string"
    },
    "QualityFlagV4": {
      "enum": [
        "context_dependent_opening",
        "incomplete_ending",
        "irrelevant_intro",
        "irrelevant_outro",
        "irrelevant_internal_content",
        "repeated_live_cta",
        "equipment_interruption",
        "padded_to_min_duration",
        "overextended_to_max_duration",
        "topic_mixed",
        "title_source_mismatch",
        "asr_meaning_reversal",
        "duplicate_weaker",
        "central_objective_incomplete",
        "multi_interval_edit",
        "topic_too_long_without_natural_split"
      ],
      "title": "QualityFlagV4",
      "type": "string"
    },
    "RiskFlagV4": {
      "enum": [
        "medical_claim",
        "health_advice",
        "absolute_claim",
        "commercial_claim",
        "sensitivity_review",
        "music_rights_review",
        "minor_privacy",
        "asr_uncertain"
      ],
      "title": "RiskFlagV4",
      "type": "string"
    },
    "ShortHighlightScoresV4": {
      "additionalProperties": false,
      "properties": {
        "independence": {
          "maximum": 20,
          "minimum": 0,
          "title": "Independence",
          "type": "integer"
        },
        "completeness": {
          "maximum": 20,
          "minimum": 0,
          "title": "Completeness",
          "type": "integer"
        },
        "single_topic": {
          "maximum": 15,
          "minimum": 0,
          "title": "Single Topic",
          "type": "integer"
        },
        "viewer_value": {
          "maximum": 20,
          "minimum": 0,
          "title": "Viewer Value",
          "type": "integer"
        },
        "source_fidelity": {
          "maximum": 15,
          "minimum": 0,
          "title": "Source Fidelity",
          "type": "integer"
        },
        "edit_cleanliness": {
          "maximum": 10,
          "minimum": 0,
          "title": "Edit Cleanliness",
          "type": "integer"
        }
      },
      "required": [
        "independence",
        "completeness",
        "single_topic",
        "viewer_value",
        "source_fidelity",
        "edit_cleanliness"
      ],
      "title": "ShortHighlightScoresV4",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "4",
      "default": "4",
      "title": "Schema Version",
      "type": "string"
    },
    "clip_profile": {
      "$ref": "#/$defs/ClipProfile"
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/CandidateGlobalReviewV4"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Reviews",
      "type": "array"
    },
    "global_notes": {
      "items": {
        "type": "string"
      },
      "maxItems": 80,
      "title": "Global Notes",
      "type": "array"
    }
  },
  "required": [
    "clip_profile",
    "reviews"
  ],
  "title": "GlobalReviewOutputV4",
  "type": "object"
}
