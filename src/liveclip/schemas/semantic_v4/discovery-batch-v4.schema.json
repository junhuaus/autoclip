{
  "$defs": {
    "ClipProfile": {
      "description": "Independent editorial units with different deterministic duration contracts.",
      "enum": [
        "short_highlight",
        "mini_lesson"
      ],
      "title": "ClipProfile",
      "type": "string"
    },
    "DiscoveryCandidateV4": {
      "additionalProperties": false,
      "description": "High-recall discovery proposal; no score, risk gate, or duration gate is applied here.",
      "properties": {
        "candidate_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Candidate Id",
          "type": "string"
        },
        "source_topic_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Topic Id",
          "type": "string"
        },
        "topic_fragment_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 80,
          "minItems": 1,
          "title": "Topic Fragment Ids",
          "type": "array"
        },
        "topic_summary": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Topic Summary",
          "type": "string"
        },
        "central_question": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Central Question",
          "type": "string"
        },
        "learning_outcome": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Learning Outcome",
          "type": "string"
        },
        "start_cue_id": {
          "minimum": 1,
          "title": "Start Cue Id",
          "type": "integer"
        },
        "end_cue_id": {
          "minimum": 1,
          "title": "End Cue Id",
          "type": "integer"
        },
        "evidence_cue_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 160,
          "minItems": 1,
          "title": "Evidence Cue Ids",
          "type": "array"
        },
        "possible_profiles": {
          "items": {
            "$ref": "#/$defs/ClipProfile"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Possible Profiles",
          "type": "array"
        },
        "risk_flags": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Risk Flags",
          "type": "array"
        },
        "source_window_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Source Window Ids",
          "type": "array"
        },
        "source_batch_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Batch Id",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "source_topic_id",
        "topic_fragment_ids",
        "topic_summary",
        "central_question",
        "learning_outcome",
        "start_cue_id",
        "end_cue_id",
        "evidence_cue_ids",
        "possible_profiles",
        "source_window_ids",
        "source_batch_id"
      ],
      "title": "DiscoveryCandidateV4",
      "type": "object"
    },
    "LogicalWindowDiscoveryV4": {
      "additionalProperties": false,
      "properties": {
        "logical_window_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Logical Window Id",
          "type": "string"
        },
        "window_start_ms": {
          "minimum": 0,
          "title": "Window Start Ms",
          "type": "integer"
        },
        "window_end_ms": {
          "exclusiveMinimum": 0,
          "title": "Window End Ms",
          "type": "integer"
        },
        "candidate_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Candidate Ids",
          "type": "array"
        },
        "fragment_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Fragment Ids",
          "type": "array"
        },
        "left_boundary": {
          "$ref": "#/$defs/TopicBoundaryV4"
        },
        "right_boundary": {
          "$ref": "#/$defs/TopicBoundaryV4"
        },
        "coverage_notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "title": "Coverage Notes",
          "type": "array"
        }
      },
      "required": [
        "logical_window_id",
        "window_start_ms",
        "window_end_ms",
        "left_boundary",
        "right_boundary"
      ],
      "title": "LogicalWindowDiscoveryV4",
      "type": "object"
    },
    "TimeRangeV4": {
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "title": "TimeRangeV4",
      "type": "object"
    },
    "TopicBoundaryV4": {
      "additionalProperties": false,
      "properties": {
        "continues_previous_topic": {
          "default": false,
          "title": "Continues Previous Topic",
          "type": "boolean"
        },
        "topic_unfinished": {
          "default": false,
          "title": "Topic Unfinished",
          "type": "boolean"
        },
        "topic_summary": {
          "default": "",
          "maxLength": 320,
          "title": "Topic Summary",
          "type": "string"
        },
        "central_question": {
          "default": "",
          "maxLength": 320,
          "title": "Central Question",
          "type": "string"
        },
        "continuation_expected": {
          "default": false,
          "title": "Continuation Expected",
          "type": "boolean"
        },
        "evidence_cue_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 80,
          "title": "Evidence Cue Ids",
          "type": "array"
        },
        "related_candidate_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 60,
          "title": "Related Candidate Ids",
          "type": "array"
        },
        "related_fragment_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 60,
          "title": "Related Fragment Ids",
          "type": "array"
        }
      },
      "title": "TopicBoundaryV4",
      "type": "object"
    },
    "TopicFragmentV4": {
      "additionalProperties": false,
      "properties": {
        "topic_fragment_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Topic Fragment Id",
          "type": "string"
        },
        "logical_window_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Logical Window Id",
          "type": "string"
        },
        "topic_summary": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Topic Summary",
          "type": "string"
        },
        "central_question": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Central Question",
          "type": "string"
        },
        "learning_outcome": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Learning Outcome",
          "type": "string"
        },
        "start_cue_id": {
          "minimum": 1,
          "title": "Start Cue Id",
          "type": "integer"
        },
        "end_cue_id": {
          "minimum": 1,
          "title": "End Cue Id",
          "type": "integer"
        },
        "touches_left_boundary": {
          "title": "Touches Left Boundary",
          "type": "boolean"
        },
        "touches_right_boundary": {
          "title": "Touches Right Boundary",
          "type": "boolean"
        },
        "left_complete": {
          "title": "Left Complete",
          "type": "boolean"
        },
        "right_complete": {
          "title": "Right Complete",
          "type": "boolean"
        },
        "evidence_cue_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 120,
          "minItems": 1,
          "title": "Evidence Cue Ids",
          "type": "array"
        },
        "possible_profiles": {
          "items": {
            "$ref": "#/$defs/ClipProfile"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Possible Profiles",
          "type": "array"
        },
        "source_batch_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source Batch Id",
          "type": "string"
        }
      },
      "required": [
        "topic_fragment_id",
        "logical_window_id",
        "topic_summary",
        "central_question",
        "learning_outcome",
        "start_cue_id",
        "end_cue_id",
        "touches_left_boundary",
        "touches_right_boundary",
        "left_complete",
        "right_complete",
        "evidence_cue_ids",
        "possible_profiles",
        "source_batch_id"
      ],
      "title": "TopicFragmentV4",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "4",
      "default": "4",
      "title": "Schema Version",
      "type": "string"
    },
    "batch_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Batch Id",
      "type": "string"
    },
    "batch_context": {
      "$ref": "#/$defs/TimeRangeV4"
    },
    "ownership_interval": {
      "$ref": "#/$defs/TimeRangeV4"
    },
    "logical_windows": {
      "items": {
        "$ref": "#/$defs/LogicalWindowDiscoveryV4"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Logical Windows",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/DiscoveryCandidateV4"
      },
      "maxItems": 160,
      "title": "Candidates",
      "type": "array"
    },
    "topic_fragments": {
      "items": {
        "$ref": "#/$defs/TopicFragmentV4"
      },
      "maxItems": 200,
      "title": "Topic Fragments",
      "type": "array"
    }
  },
  "required": [
    "batch_id",
    "batch_context",
    "ownership_interval",
    "logical_windows"
  ],
  "title": "DiscoveryBatchOutputV4",
  "type": "object"
}
